DATABASE_URL=postgresql+psycopg://easyhr:easyhr@localhost:5432/easyhr
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720
# Base domain used to resolve tenant subdomains (alphabet-inc.localhost)
BASE_DOMAIN=localhost

# --- Production only (see DEPLOY_RAILWAY.md) -------------------------------------------
# ENVIRONMENT=production         # refuses the default JWT_SECRET, makes the session cookie HTTPS-only
# MASTER_ADMIN_EMAIL=you@yourcompany.com
# MASTER_ADMIN_PASSWORD=          # at least 12 characters; used once, to create the first master admin
# SEED_DEMO=false                 # true loads the Alphabet Inc. demo company and its public demo logins
