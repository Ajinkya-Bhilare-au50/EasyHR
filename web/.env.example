# FastAPI backend base URL (proxied under /api). Use 127.0.0.1, not localhost: on Windows
# "localhost" tries IPv6 first and some clients wait ~2s before falling back to IPv4.
API_URL=http://127.0.0.1:8000
# Company subdomains: <workspace>.<NEXT_PUBLIC_BASE_DOMAIN> fills in the workspace on the sign-in page.
# Must match the API's BASE_DOMAIN. Baked in at build time.
# NEXT_PUBLIC_BASE_DOMAIN=localhost
